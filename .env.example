# Configuration Hugging Face
HF_TOKEN=your_huggingface_token_here

# Chemin vers le dossier contenant les notes Obsidian
# Par défaut: ./notes (relatif au projet)
VAULT_PATH=./notes

# Modèles
EMBEDDING_MODEL=google/embeddinggemma-300m

# LLM: Utilisez un modèle MLX pré-converti sur Mac (recommandé)
# Mac M4 (MLX) - Modèles optimisés 4-bit:
LLM_MODEL=mlx-community/Mistral-7B-Instruct-v0.3-4bit
# Alternatives MLX (consultez https://huggingface.co/mlx-community):
#   LLM_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit
#   LLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
#   LLM_MODEL=mlx-community/Ministral-8B-Instruct-2410-4bit

# Windows/Linux (CUDA) - Modèles standard Hugging Face:
#   LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
#   LLM_MODEL=mistralai/Ministral-8B-Instruct-2410

